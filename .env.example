# Database
DATABASE_URL=postgresql+psycopg://securerecruit:securerecruit@localhost:5432/securerecruit

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI (optional — without key, local heuristic analyzer is used)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Uploads
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:80

# App
APP_NAME=SecureRecruit
APP_ENV=development
DEBUG=true
